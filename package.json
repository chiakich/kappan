{
  "name": "kappan",
  "version": "0.1.0",
  "description": "Letterpress texture and CJK typesetting — paper grain, ink-bite SVG filters, per-character jitter. Framework-free core, optional React shell.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.tsx",
      "default": "./src/react.tsx"
    },
    "./dist/*": "./dist/*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "author": "Chiaki.C",
  "keywords": [
    "letterpress",
    "typography",
    "chinese",
    "vertical-writing",
    "svg-filter",
    "css"
  ],
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild scripts/build-dist.ts --bundle --platform=node --format=esm --outfile=scripts/.build-dist.mjs --log-level=error && node scripts/.build-dist.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiakich/kappan.git"
  },
  "homepage": "https://github.com/chiakich/kappan#readme",
  "bugs": {
    "url": "https://github.com/chiakich/kappan/issues"
  }
}
